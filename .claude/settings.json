{
  "version": "1.0",
  "project": "physonic_mvp",
  "description": "Physics-driven acoustic synthesis for robot perception training",

  "permissions": {
    "allowed_commands": [
      "python3",
      "pip",
      "pytest",
      "mujoco",
      "ffmpeg",
      "git"
    ],
    "blocked_paths": [
      ".env",
      "**/*credentials*",
      "**/*secret*",
      "**/*api_key*"
    ],
    "max_file_read_size_mb": 50,
    "allow_network": true
  },

  "development": {
    "python_version": "3.9+",
    "virtual_env_path": ".venv",
    "test_framework": "pytest",
    "coverage_threshold": 0.8
  },

  "phases": {
    "current": "3b",
    "completed": ["1", "2a", "2b", "2c", "3a"],
    "in_progress": ["3b"],
    "planned": ["3c", "4a", "4b", "4c", "4d"]
  },

  "external_dependencies": {
    "hrtf_dataset": {
      "source": "MIT KEMAR",
      "url": "https://sound.media.mit.edu/resources/KEMAR.html",
      "local_path": "./assets/hrtf/mit_kemar/",
      "required_for": "phase_2a"
    },
    "3d_assets": {
      "sources": ["Sketchfab", "Google Poly Archive"],
      "local_path": "./assets/models/",
      "required_for": "phase_3b"
    }
  },

  "validation": {
    "spatial_audio_itd_tolerance_ms": 0.1,
    "spatial_audio_ild_tolerance_db": 2.0,
    "listening_test_pass_rate": 0.8,
    "rl_localization_error_threshold_deg": 15,
    "rl_classification_accuracy_threshold": 0.9
  }
}
